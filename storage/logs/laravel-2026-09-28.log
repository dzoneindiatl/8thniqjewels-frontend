","returnexchangeProduct":"<pre class=sf-dump id=sf-dump-1920777442 data-indent-pad=\"  \"><span class=sf-dump-note>App\\Models\\Setting</span> {<a class=sf-dump-ref>#1459</a><samp data-depth=1 class=sf-dump-expanded>
  #<span class=sf-dump-protected title=\"Protected property\">connection</span>: \"<span class=sf-dump-str title=\"5 characters\">mysql</span>\"
  #<span class=sf-dump-protected title=\"Protected property\">table</span>: \"<span class=sf-dump-str title=\"8 characters\">settings</span>\"
  #<span class=sf-dump-protected title=\"Protected property\">primaryKey</span>: \"<span class=sf-dump-str title=\"2 characters\">id</span>\"
