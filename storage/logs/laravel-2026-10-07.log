    \"<span class=sf-dump-key>Homepage.about_footer</span>\" => \"<span class=sf-dump-str title=\"349 characters\">At 8thniq, we celebrate the timeless beauty of handcrafted Jadau silver jewellery. Each piece is thoughtfully designed and brought to life by skilled artisans, blending traditional techniques like Meenakari with contemporary aesthetics. From statement bridal pieces to elegant occasion wear, our creations are made to be treasured for years to come.</span>\"
    \"<span class=sf-dump-key>Site.admin_logo</span>\" => \"<span class=sf-dump-str title=\"31 characters\">APR2026/1775035630-settings.svg</span>\"
    \"<span class=sf-dump-key>Reading.default_currency</span>\" => \"<span class=sf-dump-str title=\"5 characters\">&#8377;1231</span>\"
    \"<span class=sf-dump-key>Social.whatsapp</span>\" => \"<span class=sf-dump-str title=\"13 characters\">+919636861568</span>\"
    \"<span class=sf-dump-key>Product.return_exchange</span>\" => \"\"\"
      <span class=sf-dump-str title=\"938 characters\">&lt;h5&gt;RISK FREE SHOPPING&lt;/h5&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"938 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"938 characters\">&lt;p&gt;You can return or exchange any product if you are not satisfied with the fit or size, within 60 days from the date of delivery.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"938 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"938 characters\">&lt;h5&gt;ELIGIBILITY&lt;/h5&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"938 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"938 characters\">&lt;p&gt;Products must be unused, unwashed, undamaged and should have all the original tags and packaging. Once your return is processed, the full product price, including taxes, will be returned to you. Any additional shipping charges, if paid, are not returned.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"938 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"938 characters\">&lt;h5&gt;PROCESS&lt;/h5&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"938 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"938 characters\">&lt;p&gt;To initiate a return/exchange, create a request here. Alternatively, you can also contact us with your order details.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"938 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"938 characters\">&lt;p&gt;Our warehouse team typically takes around 48-72 hours to inspect all items due for returns or exchanges. Once approved, it&amp;rsquo;ll take upto 7 business days for the amount to reflect in your back account in case of a refund.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"938 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"938 characters\">&lt;p&gt;For an exchange, we&amp;rsquo;ll ship out your new size/product once the pickup is completed.&lt;/p&gt;</span>
      \"\"\"
